# ─────────────────────────────────────────────────────────────────────────────
# Environment Variables Template
# Copy to .env and fill in your API keys
# ─────────────────────────────────────────────────────────────────────────────

# AQICN API (https://aqicn.org/data-platform/token/)
AQICN_API_KEY=demo

# OpenWeatherMap (https://openweathermap.org/api)
OPENWEATHER_API_KEY=

# ClearML Configuration
CLEARML_API_ACCESS_KEY=
CLEARML_API_SECRET_KEY=

# Target Location
TARGET_CITY=Sargodha
TARGET_LATITUDE=32.0836
TARGET_LONGITUDE=72.6711
TARGET_TIMEZONE=Asia/Karachi

# Model Configuration
FORECAST_HORIZON_HOURS=72
LOOKBACK_WINDOW_HOURS=72
AQI_ALERT_THRESHOLD=150

# LSTM Hyperparameters
LSTM_HIDDEN_SIZE=128
LSTM_NUM_LAYERS=2
LSTM_DROPOUT=0.3
LSTM_LEARNING_RATE=0.001
LSTM_EPOCHS=100
LSTM_BATCH_SIZE=64

# LightGBM Tuning
OPTUNA_N_TRIALS=50

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
LOG_LEVEL=INFO

# API Security (leave empty to disable authentication)
API_AUTH_KEY=
CORS_ORIGINS=

# Error Tracking (optional — https://sentry.io)
SENTRY_DSN=
